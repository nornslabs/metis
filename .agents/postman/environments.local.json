    { "key": "sessionToken", "value": "", "type": "string", "enabled": true, "description": "Session cookie value (from /v1/auth/google/callback)" },
    { "key": "SESSION_COOKIE_NAME", "value": "metis_session", "type": "string", "enabled": true, "description": "Session cookie name" },
    { "key": "keyKind", "value": "llm", "type": "string", "enabled": true, "description": "Provider kind: llm or exa" }
  ]
}