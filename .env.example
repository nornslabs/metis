# Metis Environment Configuration
# Copy this file to .env and fill in your values.

# App settings
APP_ENV=development
LOG_LEVEL=INFO
LOG_JSON=false

# Infrastructure
# Outside compose this is the owner role (needed for `alembic upgrade head`).
# Compose ignores it: services connect as `metis_app`, migrate as the owner.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/metis
# Password migration 0004 gives the non-superuser `metis_app` role (LOGIN).
APP_DB_PASSWORD=metis_app
DB_POOL_SIZE=10
REDIS_URL=redis://localhost:6379/0
# Per-run lock: expires soon after a worker dies so crash recovery can resume the run.
# The heartbeat keeps it alive while the run is live; it must be under half the TTL.
RUN_LOCK_TTL_SECONDS=60
RUN_LOCK_HEARTBEAT_SECONDS=20

# Security (required - generate secure random values)
# Generate with: python -c "import secrets; import base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
ENCRYPTION_MASTER_KEY=your-32-byte-base64-encoded-key-here

# CORS and public URL
# Multiple origins can be comma-separated: http://localhost:3000,http://localhost:8000
CORS_ORIGINS=http://localhost:3000
WEB_BASE_URL=http://localhost:3000

# Session cookie (server-side sessions)
SESSION_COOKIE_NAME=metis_session
SESSION_TTL_DAYS=30
SESSION_IDLE_DAYS=7
# Optional: set when the web app and API share a parent domain (e.g. .metis.app)
COOKIE_DOMAIN=
# Optional: unset means Secure everywhere except APP_ENV=development
COOKIE_SECURE=

# Google sign-in (OAuth client from Google Cloud Console → Credentials).
# Required outside APP_ENV=development; in development, unset means no Google sign-in.
# The redirect URI must be registered on the OAuth client exactly as written here.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/v1/auth/google/callback

# Observability (optional)
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
# Optional LLM prices (JSON): {"model-id": {"input_per_million_usd": 0.15, "output_per_million_usd": 0.60}}
LLM_PRICES=