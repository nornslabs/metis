# Metis Environment Configuration
# Copy this file to .env and fill in your values.

# App settings
APP_ENV=development
LOG_LEVEL=INFO
LOG_JSON=false

# Infrastructure
# Outside compose this is the owner role (needed for `alembic upgrade head`).
# Compose ignores it: services connect as `metis_app`, migrate as the owner.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/metis
# Password migration 0004 gives the non-superuser `metis_app` role (LOGIN).
APP_DB_PASSWORD=metis_app
DB_POOL_SIZE=10
REDIS_URL=redis://localhost:6379/0

# Security (required - generate secure random values)
# Generate with: python -c "import secrets; import base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# HS256 key shared with the web app, which mints API tokens with it (>= 32 bytes)
AUTH_JWT_SECRET=your-256-bit-jwt-secret-here
AUTH_JWT_AUDIENCE=metis
ENCRYPTION_MASTER_KEY=your-32-byte-base64-encoded-key-here

# CORS and public URL
# Multiple origins can be comma-separated: http://localhost:3000,http://localhost:8000
CORS_ORIGINS=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3000

# Observability (optional)
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=