# Metis Environment Configuration
# Copy this file to .env and fill in your values.

# App settings
APP_ENV=development
LOG_LEVEL=INFO
LOG_JSON=false
POSTGRES_PASSWORD=change-me
# Infrastructure
# Outside compose this is the owner role (needed for `alembic upgrade head`).
# Compose ignores it: services connect as `metis_app`, migrate as the owner.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/metis
# Password migration 0004 gives the non-superuser `metis_app` role (LOGIN).
APP_DB_PASSWORD=metis_app
DB_POOL_SIZE=10
REDIS_URL=redis://localhost:6379/0
# Per-run lock: expires soon after a worker dies so crash recovery can resume the run.
# The heartbeat keeps it alive while the run is live; it must be under half the TTL.
RUN_LOCK_TTL_SECONDS=60
RUN_LOCK_HEARTBEAT_SECONDS=20
# Run recovery: scan interval in seconds (5-59), max recoveries per run, and seconds without progress before a run fails as stalled (min 300)
RUN_RECOVERY_INTERVAL_SECONDS=30
RUN_RECOVERY_MAX_ATTEMPTS=3
RUN_STALL_SECONDS=900
# Hard cap on one agent job, in seconds (minimum 60).
AGENT_JOB_TIMEOUT_SECONDS=1800
# true: every agent specialist is a stub (no LLM calls). Only for the web e2e stack.
AGENT_STUB_SPECIALISTS=false

# Security (required - generate secure random values)
# Generate with: python -c "import secrets; import base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
ENCRYPTION_MASTER_KEY=your-32-byte-base64-encoded-key-here

# CORS and public URL
# Multiple origins can be comma-separated: http://localhost:3000,http://localhost:8000
CORS_ORIGINS=http://localhost:3000
WEB_BASE_URL=http://localhost:3000

# Session cookie (server-side sessions)
SESSION_COOKIE_NAME=metis_session
SESSION_TTL_DAYS=30
SESSION_IDLE_DAYS=7
# Optional: set when the web app and API share a parent domain (e.g. .metis.app)
COOKIE_DOMAIN=
# Optional: unset means Secure everywhere except APP_ENV=development
COOKIE_SECURE=

# Google sign-in (OAuth client from Google Cloud Console → Credentials).
# Required outside APP_ENV=development; in development, unset means no Google sign-in.
# The redirect URI must be registered on the OAuth client exactly as written here.
# It points at the web origin: the web app forwards /v1/* to the API, so the session cookie
# the callback sets belongs to the web origin.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/v1/auth/google/callback

# Web app: where the Next.js server forwards /v1/* (read at build time and by server components).
# Locally with `npm run dev`: http://localhost:8000. In compose: http://api:8000 (set for you).
API_ORIGIN=http://localhost:8000

# Observability (optional)
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
# Chat call timeouts in seconds: short calls (default 60) and long-output calls, spec and plan (default 240, not below the short one)
LLM_CALL_TIMEOUT_SECONDS=60
LLM_LONG_CALL_TIMEOUT_SECONDS=240
# Optional LLM prices (JSON): {"model-id": {"input_per_million_usd": 0.15, "output_per_million_usd": 0.60}}
LLM_PRICES={}
# Speech-to-text provider: sarvam | web-speech | mock (default: web-speech, free, no key)
# STT_PROVIDER=web-speech

# Embedding model used with the workspace's LLM key; must return 1536-dim vectors (default text-embedding-3-small)
LLM_EMBEDDING_MODEL=text-embedding-3-small
